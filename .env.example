# =======================================================
# EXPENSE TRACKER - SYSTEM EMAIL & PIN RECOVERY CONFIG
# =======================================================
# Copy this file to .env and fill in your Google App Password:
# 1. Visit Google Account Security: https://myaccount.google.com/security
# 2. Ensure "2-Step Verification" is turned ON.
# 3. Go to "App passwords": https://myaccount.google.com/apppasswords
# 4. Create an App password (e.g. name it "Expense Tracker").
# 5. Copy the 16-character code and paste it into GMAIL_APP_PASSWORD.

GMAIL_USER=cindrellakoju@gmail.com
SYSTEM_EMAIL=cindrellakoju@gmail.com
EXPO_PUBLIC_SYSTEM_EMAIL=cindrellakoju@gmail.com

GMAIL_APP_PASSWORD=your_google_app_password_here
SYSTEM_APP_PASSWORD=your_google_app_password_here
EXPO_PUBLIC_SYSTEM_APP_PASSWORD=your_google_app_password_here

# Recovery email is added by the user themselves inside Admin Settings in the app
RECOVERY_EMAIL=
EXPO_PUBLIC_RECOVERY_EMAIL=

# Developer Mode (Set to 'true' to show Developer / Debug tools like "Clear All Data" button in Home)
IS_DEV_MODE=true
EXPO_PUBLIC_IS_DEV_MODE=true

